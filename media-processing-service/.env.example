# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_PORT=8000
APP_HOST=0.0.0.0
MAX_UPLOAD_SIZE_MB=500

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_BASE_DIR=./storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=media-processing-bucket
S3_PRESIGNED_EXPIRATION_SECONDS=3600

# Redis (Job Status & Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# RabbitMQ (Celery Broker)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Celery
CELERY_TASK_TIMEOUT=600
CELERY_MAX_RETRIES=3
CELERY_RETRY_BACKOFF=5
